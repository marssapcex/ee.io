# ─────────────────────────────────────────────────────────────────────────────
# ee.io configuration
#
# Copy to `.env` and fill in. Every value is optional: with no configuration
# the server runs entirely on the deterministic simulator, which is useful for
# development and for the public demo but is NOT tradeable.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Revenue ──────────────────────────────────────────────────────────────────
# Where the affiliate fee lands. MUST be set before taking real volume — the
# built-in default is a placeholder and the server warns loudly about it.
#
# Note: the address below is stored in its correct EIP-55 checksum form. Strict
# integrators (0x, ParaSwap) reject a mis-cased address even though the bytes
# are identical.
EE_FEE_RECIPIENT_EVM=0x8829C3516E8E67f5B6aC815F89a50aE68840a664

# Solana fee account. Since January 2025 Jupiter no longer requires the
# Referral Program: this may be ANY token account for one of the mints in the
# pair being swapped. Without it, Solana routes are quoted but earn nothing.
# EE_FEE_RECIPIENT_SOLANA=

# THORChain affiliate. A THORName is strongly preferred over a raw thor1…
# address: it is far shorter inside the memo (critical for Bitcoin's 80-byte
# OP_RETURN) and it unlocks preferred-asset payouts. Without this, the
# affiliate fields are omitted from the memo and cross-chain swaps earn nothing.
#   Register: https://dev.thorchain.org/affiliate-guide/thorname-guide.html
# EE_THORNAME=ee

# Fee schedule in basis points. 50 = 0.50%, 100 = 1.00%.
# Float quotes float with the market; fixed quotes are locked for 10 minutes
# and carry the wider spread to cover that risk.
EE_FLOAT_FEE_BPS=50
EE_FIXED_FEE_BPS=100

# Which side of the trade to skim. "output" keeps the input amount exact, which
# is what users expect when they type "send 1 ETH".
#   Caveat: OpenOcean ALWAYS charges on the input regardless of this setting —
#   its referrerFee is deducted from the in-token by the protocol itself.
EE_FEE_SIDE=output

# Attribution string sent to providers that support it (KyberSwap's
# x-client-id header, ParaSwap's `partner`, 0x's source tag).
EE_CLIENT_ID=ee-io

# ── Aggregator credentials ───────────────────────────────────────────────────
# Without a key the adapter is skipped and the route falls back to the
# simulator, clearly labelled SIMULATED in the UI.

# 0x Swap API v2 — free key from https://dashboard.0x.org
# Required: 0x serves no anonymous traffic. Sends `0x-api-key` + `0x-version: v2`.
# ZEROX_API_KEY=

# 1inch — https://portal.1inch.dev
# Note the base URL migrated from api.1inch.dev to api.1inch.com.
# ONEINCH_API_KEY=

# OpenOcean — optional. The public tier works keyless at 2 requests/second;
# a key raises that limit.
# OPENOCEAN_API_KEY=

# Jupiter (Solana) — optional for the public tier.
# lite-api.jup.ag is deprecated as of 31 Jan 2026; use api.jup.ag.
# JUPITER_API_KEY=
# JUPITER_API_URL=https://api.jup.ag/swap/v1

# KyberSwap and ParaSwap need no key at all — KyberSwap only wants the
# x-client-id header, which EE_CLIENT_ID supplies.

# ── Infrastructure ───────────────────────────────────────────────────────────
# THORChain node. The public Nine Realms endpoint rate-limits at 1 req/s/IP and
# returns 503 when exceeded. Run your own node for production traffic.
# THORNODE_URL=https://thornode.ninerealms.com

# CoinGecko for USD reference pricing. Without a key the free tier is used and
# the server silently falls back to built-in reference prices on failure.
# COINGECKO_API_KEY=

# API port. The Vite dev server proxies /api to this.
API_PORT=8787

# Milliseconds before a slow aggregator is dropped from the comparison. Every
# provider is queried in parallel under this single deadline.
EE_QUOTE_DEADLINE_MS=7000

# Force the deterministic simulator even when keys are present. Useful for
# demos, screenshots and CI (the test suite sets this automatically).
# EE_FORCE_SIMULATION=1
