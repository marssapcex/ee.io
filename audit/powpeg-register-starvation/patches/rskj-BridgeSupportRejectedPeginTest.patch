+    /*
+     * Regression test for the "registerBtcTransaction budget flood" report.
+     *
+     * The transaction is valid from the point of view of the federation the federator
+     * watches (500_000 sat to the active federation, i.e. >= minimumPeginTxValue) but
+     * carries a sub-minimum output to the OTHER live federation (the retiring one).
+     * evaluatePegin() looks at all live federations, so the Bridge rejects it with
+     * INVALID_AMOUNT; and after RSKIP551 that rejection does not mark the transaction as
+     * processed, which is what makes the federator re-send it on every single turn.
+     */
+    @ParameterizedTest
+    @MethodSource("activationsProvider")
+    void registerBtcTransaction_whenPeginIsValidForActiveFedButBelowMinimumForRetiringFed_shouldRejectAndStayUnprocessed(
+        ActivationConfig.ForBlock activations
+    ) throws BlockStoreException, BridgeIllegalArgumentException, IOException {
+        // arrange
+        Coin amountToRetiringFed = Coin.valueOf(2_000L);   // above dust, far below the minimum
+        BtcTransaction btcTransaction = new BtcTransaction(btcMainnetParams);
+        btcTransaction.addInput(BitcoinTestUtils.createHash(1), FIRST_OUTPUT_INDEX,
+            new Script(new byte[]{}));
+        btcTransaction.addOutput(minimumPeginTxValue, activeFederation.getAddress());
+        btcTransaction.addOutput(amountToRetiringFed, retiringFederation.getAddress());
+
+        when(federationStorageProvider.getOldFederation(federationMainnetConstants,
+            activations)).thenReturn(retiringFederation);
+        FederationSupport federationSupport = FederationSupportBuilder.builder()
+            .withFederationConstants(federationMainnetConstants)
+            .withFederationStorageProvider(federationStorageProvider)
+            .withActivations(activations)
+            .withRskExecutionBlock(rskExecutionBlock)
+            .build();
+
+        BridgeSupport bridgeSupport = BridgeSupportBuilder.builder()
+            .withBtcBlockStoreFactory(mockFactory)
+            .withBridgeConstants(bridgeMainnetConstants)
+            .withRepository(repository)
+            .withProvider(provider)
+            .withActivations(activations)
+            .withEventLogger(bridgeEventLogger)
+            .withBtcLockSenderProvider(btcLockSenderProvider)
+            .withPeginInstructionsProvider(peginInstructionsProvider)
+            .withExecutionBlock(rskExecutionBlock)
+            .withFederationSupport(federationSupport)
+            .build();
+
+        // act
+        bridgeSupport.registerBtcTransaction(
+            rskTx,
+            btcTransaction.bitcoinSerialize(),
+            heightAtWhichToStartUsingPegoutIndex,
+            createPmtAndMockBlockStore(btcTransaction).bitcoinSerialize()
+        );
+
+        // assert: rejected, and with RSKIP551 active it is NOT marked as processed,
+        // which is exactly why the powpeg node keeps re-sending it
+        assertInvalidPeginMarkedAsProcessed(activations);
+
+        ArgumentCaptor<RejectedPeginReason> rejectedReason =
+            ArgumentCaptor.forClass(RejectedPeginReason.class);
+        verify(bridgeEventLogger, times(1))
+            .logRejectedPegin(eq(btcTransaction), rejectedReason.capture());
+        // both of these are permanent NO_REFUND reasons for a legacy peg-in: the
+        // rejection cannot become a valid peg-in later, and (post-RSKIP551) it does
+        // not mark the transaction as processed either
+        assertTrue(
+            EnumSet.of(INVALID_AMOUNT, RejectedPeginReason.LEGACY_PEGIN_UNDETERMINED_SENDER)
+                .contains(rejectedReason.getValue()),
+            "unexpected rejected reason: " + rejectedReason.getValue());
+
+        verify(bridgeEventLogger, never()).logPeginBtc(any(), any(), any(), anyInt());
+        assertTrue(activeFederationUtxos.isEmpty(), "no UTXO may be added for a rejected peg-in");
+        assertTrue(retiringFederationUtxos.isEmpty(), "no UTXO may be added for a rejected peg-in");
+    }
+
