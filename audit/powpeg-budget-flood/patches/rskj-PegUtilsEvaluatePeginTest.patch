+
+    /*
+     * Regression tests for the "registerBtcTransaction budget flood" report.
+     *
+     * evaluatePegin() receives the wallet of *all* live federations. A transaction that
+     * pays the minimum to the active federation but a sub-minimum amount to the other
+     * live federation (the retiring one during a federation change) is rejected with
+     * NO_REFUND/INVALID_AMOUNT, and -- after RSKIP551 -- that rejection does not mark the
+     * transaction as processed, so the federator keeps re-sending it.
+     */
+
+    private BtcTransaction createPeginTxWithSubMinimumOutputTo(
+        Federation otherLiveFederation,
+        Coin amountToOtherLiveFederation
+    ) {
+        BtcTransaction btcTx = new BtcTransaction(networkParameters);
+        btcTx.addInput(
+            BitcoinTestUtils.createHash(1),
+            0,
+            ScriptBuilder.createInputScript(null, new BtcECKey())
+        ); // legacy p2pkh sender
+        btcTx.addOutput(minimumPegInTxValue, activeFederation.getAddress());
+        btcTx.addOutput(amountToOtherLiveFederation, otherLiveFederation.getAddress());
+        return btcTx;
+    }
+
+    @Test
+    void evaluatePegin_subMinimumOutputToAnotherLiveFederation_isRejectedWithInvalidAmount() {
+        Federation retiringFederation = createP2shErpFederation(
+            bridgeMainnetConstants.getFederationConstants(),
+            BitcoinTestUtils.getBtcEcKeysFromSeeds(
+                new String[]{"fb01", "fb02", "fb03", "fb04", "fb05"}, true
+            )
+        );
+        Wallet liveFederationsWallet = new BridgeBtcWallet(
+            context, List.of(activeFederation, retiringFederation)
+        );
+
+        BtcTransaction btcTx = createPeginTxWithSubMinimumOutputTo(
+            retiringFederation, Coin.valueOf(2_000)
+        );
+
+        PeginInformation peginInformation = mock(PeginInformation.class);
+        when(peginInformation.getProtocolVersion()).thenReturn(0);
+
+        PeginEvaluationResult peginEvaluationResult = PegUtils.evaluatePegin(
+            btcTx,
+            peginInformation,
+            minimumPegInTxValue,
+            liveFederationsWallet,
+            activations
+        );
+
+        assertEquals(PeginProcessAction.NO_REFUND, peginEvaluationResult.getPeginProcessAction());
+        assertEquals(
+            Optional.of(RejectedPeginReason.INVALID_AMOUNT),
+            peginEvaluationResult.getRejectedPeginReason()
+        );
+    }
+
+    @Test
+    void evaluatePegin_sameTxOnceRetiringFederationIsCleared_isRegistered() {
+        Federation retiringFederation = createP2shErpFederation(
+            bridgeMainnetConstants.getFederationConstants(),
+            BitcoinTestUtils.getBtcEcKeysFromSeeds(
+                new String[]{"fb01", "fb02", "fb03", "fb04", "fb05"}, true
+            )
+        );
+        BtcTransaction btcTx = createPeginTxWithSubMinimumOutputTo(
+            retiringFederation, Coin.valueOf(2_000)
+        );
+
+        // the retiring federation's lifetime is over: it is no longer in the live set,
+        // so its 2_000 sat output no longer drags the transaction below the minimum
+        Wallet activeFederationOnlyWallet = new BridgeBtcWallet(
+            context, List.of(activeFederation)
+        );
+        PeginInformation peginInformation = mock(PeginInformation.class);
+        when(peginInformation.getProtocolVersion()).thenReturn(0);
+
+        PeginEvaluationResult peginEvaluationResult = PegUtils.evaluatePegin(
+            btcTx,
+            peginInformation,
+            minimumPegInTxValue,
+            activeFederationOnlyWallet,
+            activations
+        );
+
+        assertEquals(PeginProcessAction.REGISTER, peginEvaluationResult.getPeginProcessAction());
+    }
